{
  "mcpServers": {
    "github": {
      "command": "sh",
      "args": [
        "-c",
        "GITHUB_PERSONAL_ACCESS_TOKEN=\"${GITHUB_PERSONAL_ACCESS_TOKEN:-$(grep -E '^(GITHUB_)?PERSONAL_ACCESS_TOKEN=' .env 2>/dev/null | head -n 1 | cut -d '=' -f2- | tr -d '\\r\\n\"')}\" exec npx -y @modelcontextprotocol/server-github"
      ]
    }
  }
}
